# ──────────────────────────────────────────────────────────────────────────────
# Add each of these as an ENVIRONMENT VARIABLE of your Node.js app on the host (never commit a real .env).
# The website, the API and the admin are ONE app on one domain, so there is no API URL / CORS setting.
# ──────────────────────────────────────────────────────────────────────────────

PORT=3000                  # most hosts inject this themselves; leave blank there
NODE_ENV=production        # "development" locally. Production turns on secure admin cookies (needs HTTPS)

# ── MySQL (create in your host panel; manage tables in phpMyAdmin) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=                   # database USER
DB_PASSWORD=
DB_NAME=                   # database NAME

# ── Admin sessions ──
# 40+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Public address, used for canonical URLs, sitemap.xml and social previews ──
SITE_URL=https://your-domain.com

# ── UPLOADED MEDIA — THE IMPORTANT ONE ──
# Folder where uploaded images/videos are saved (MySQL stores only their file names).
# It MUST be on storage that survives deployments, i.e. OUTSIDE the project folder that your host
# replaces on every deploy, for example:
#   Hostinger Node.js app:  /home/<your-user>/portfolio-uploads        (create it once, writable)
#   Container / microVM hosts (e.g. "instacloud"): the mount path of a PERSISTENT VOLUME
# If this is empty or points inside the project, a redeploy erases every upload.
# Admin -> Media -> "Storage health" tells you whether you got it right.
UPLOAD_DIR=

# ── Optional ──
# RATE_LIMIT_MAX=600       # public API requests per visitor IP per minute (a page view uses ~1)

# ── Uploads (optional) ──
# Images/videos up to 100 MB, SVG up to 10 MB. PHP limits do not apply (this is Node); a host proxy may have its own.
# REQUEST_TIMEOUT_MS=1800000   # max time for one request incl. a big upload (default 30 min)
# IMAGE_OPTIMIZE=0             # set to 0 to disable automatic WebP copies of JPEG/PNG uploads (needs the optional "sharp" package)
