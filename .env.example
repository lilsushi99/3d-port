# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local work. On Hostinger, add each of these as an
# ENVIRONMENT VARIABLE of the Node.js app (hPanel → Websites → Node.js → Environment variables).
# NEVER commit a real .env file.
#
# The website (frontend) is served BY this same Node app, so it calls /api on the same domain:
# there is NO separate frontend URL, API URL or CORS setting to configure.
# ──────────────────────────────────────────────────────────────────────────────

# Port the app listens on. Hostinger usually injects PORT itself; leave blank there.
PORT=3000

# "production" on Hostinger (turns on secure cookies, so use HTTPS). "development" locally.
NODE_ENV=production

# ── MySQL (hPanel → Databases → MySQL Databases; manage tables in phpMyAdmin) ──
DB_HOST=localhost          # usually localhost on Hostinger
DB_PORT=3306
DB_USER=                   # the database USER you created in hPanel (e.g. u123456789_portfolio)
DB_PASSWORD=               # that user's password
DB_NAME=                   # the database NAME from hPanel (e.g. u123456789_portfolio)

# ── Admin sessions ──
# Any long random string (40+ chars). Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out. Keep it secret.
JWT_SECRET=

# ── Uploaded media (images/videos from the admin) ──
# Folder on the server where files are saved. MySQL stores only the file names.
# On Hostinger use a folder OUTSIDE the deployed code so redeploys never delete uploads,
# e.g. /home/u123456789/portfolio-uploads  (create it, make sure it is writable).
UPLOAD_DIR=./uploads

# ── Optional ──
# Max API requests per visitor IP per minute (default 600). A normal page view uses ~3.
# RATE_LIMIT_MAX=600
